# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database (Prisma)
DATABASE_URL=postgresql://app_user:your_password@localhost:5433/subscription_invoice_dev?schema=public
# GCP
GOOGLE_CLOUD_PROJECT=
GCP_REGION=

# Subscription invoice monitoring
INVOICE_CHECK_INTERVAL_CRON="0 */6 * * *"
INVOICE_ALERT_WEBHOOK_URL=

# AI provider for invoice data extraction: "claude" or "bedrock". This is the authoritative
# selector for the extraction implementation — GATEWAY_URL does NOT override it. Both providers'
# requests happen to be sent to the CoreValue gateway host by default (see
# README.md#supported-providers), but each uses a different API shape (Anthropic Messages vs.
# Bedrock InvokeModel) and COREVALUE_API_KEY is required either way.
INVOICE_EXTRACTION_PROVIDER=claude
# Bearer token for the CoreValue AI gateway. Required — the app fails to start without it.
COREVALUE_API_KEY=
# CoreValue gateway base URL (default: https://gateway.corevalue.dev)
GATEWAY_URL=
# Fallback Anthropic SDK key, only used if COREVALUE_API_KEY is unset on the "claude" code path
ANTHROPIC_API_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Gmail OAuth (domain-wide delegated service account credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Mailbox to read invoice emails from
GMAIL_ADMIN_EMAIL=

# Attachment storage
# Bucket used to store invoice attachments when ATTACHMENT_STORE_DRIVER=gcs.
# Required by the env schema even when ATTACHMENT_STORE_DRIVER=local — set any placeholder value.
GCS_BUCKET_NAME=
# Storage backend for attachments: "local" or "gcs" (default: gcs)
ATTACHMENT_STORE_DRIVER=local
# Directory used to store invoice attachments when ATTACHMENT_STORE_DRIVER=local (default: .data/attachments)
ATTACHMENT_STORE_LOCAL_DIR=
